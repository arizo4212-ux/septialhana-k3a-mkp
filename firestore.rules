rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Master Data Kapal
    match /vessels/{vesselId} {
      allow read, write: if isValidId(vesselId);
    }

    // Transaksi Penumpang
    match /passengers/{passengerId} {
      allow read, write: if isValidId(passengerId);
    }

    // Transaksi Muatan Kargo
    match /cargos/{cargoId} {
      allow read, write: if isValidId(cargoId);
    }

    // Jadwal Pelayaran
    match /schedules/{scheduleId} {
      allow read, write: if isValidId(scheduleId);
    }

    // Histori Tracking & Log Aktivitas
    match /tracking_logs/{logId} {
      allow read, write: if isValidId(logId);
    }

    // Notifikasi Otomatis
    match /notifications/{notificationId} {
      allow read, write: if isValidId(notificationId);
    }

    // Users
    match /users/{userId} {
      allow read, write: if isValidId(userId);
    }
  }
}
